{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "title": "K-pi verdict",
  "type": "object",
  "required": [
    "status",
    "approved",
    "blockingIssues",
    "nonBlockingIssues",
    "evidence",
    "round",
    "output_fingerprint"
  ],
  "properties": {
    "status": {
      "enum": ["PASS", "REVISE", "BLOCKED"]
    },
    "approved": {
      "type": "boolean"
    },
    "blockingIssues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonBlockingIssues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "output_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
