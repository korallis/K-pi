{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "K-pi event",
  "type": "object",
  "required": [
    "ts",
    "type",
    "job_id",
    "round",
    "node",
    "prev_hash",
    "record_hash"
  ],
  "oneOf": [
    { "$ref": "#/$defs/handoffCreated" },
    { "$ref": "#/$defs/toolRequest" },
    { "$ref": "#/$defs/approvalResult" },
    { "$ref": "#/$defs/toolResult" },
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/handoffCompleted" },
    { "$ref": "#/$defs/recoveryStarted" },
    { "$ref": "#/$defs/recoveryCompleted" },
    { "$ref": "#/$defs/kgPatchProposed" },
    { "$ref": "#/$defs/kgPatchAccepted" },
    { "$ref": "#/$defs/accountsFailover" },
    { "$ref": "#/$defs/acRefused" },
    { "$ref": "#/$defs/loopTerminal" },
    { "$ref": "#/$defs/researchStarted" },
    { "$ref": "#/$defs/researchQuery" },
    { "$ref": "#/$defs/researchCall" },
    { "$ref": "#/$defs/researchResult" },
    { "$ref": "#/$defs/researchFallback" },
    { "$ref": "#/$defs/researchCompleted" },
    { "$ref": "#/$defs/agentSpawned" },
    { "$ref": "#/$defs/agentMessage" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "round": { "type": "integer", "minimum": 0 },
    "node": { "type": "string", "minLength": 1 },
    "text": { "type": "string" },
    "identifier": { "type": "string", "minLength": 1 },
    "service": { "enum": ["exa", "perplexity", "local"] },
    "researchMode": { "enum": ["exa", "perplexity", "auto", "local"] },
    "networkState": { "enum": ["online", "no-network"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "resultCount": { "type": "integer", "minimum": 0 },
    "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
    "pid": { "type": "integer", "minimum": 1 },
    "handoffCreated": {
      "type": "object",
      "required": [
        "ts",
        "type",
        "job_id",
        "round",
        "node",
        "prev_hash",
        "record_hash",
        "mode"
      ],
      "properties": {
        "ts": { "$ref": "#/$defs/timestamp" },
        "type": { "const": "handoff.created" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "round": { "$ref": "#/$defs/round" },
        "node": { "$ref": "#/$defs/node" },
        "prev_hash": { "$ref": "#/$defs/hash" },
        "record_hash": { "$ref": "#/$defs/hash" },
        "mode": { "enum": ["gated", "autopilot"] }
      },
      "additionalProperties": false
    },
    "toolRequest": {
      "type": "object",
      "required": [
        "ts",
        "type",
        "job_id",
        "round",
        "node",
        "prev_hash",
        "record_hash"
      ],
      "properties": {
        "ts": { "$ref": "#/$defs/timestamp" },
        "type": { "const": "tool.request" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "round": { "$ref": "#/$defs/round" },
        "node": { "$ref": "#/$defs/node" },
        "prev_hash": { "$ref": "#/$defs/hash" },
        "record_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "approvalResult": {
      "type": "object",
      "required": [
        "ts",
        "type",
        "job_id",
        "round",
        "node",
        "prev_hash",
        "record_hash",
        "approved"
      ],
      "properties": {
        "ts": { "$ref": "#/$defs/timestamp" },
        "type": { "const": "approval.result" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "round": { "$ref": "#/$defs/round" },
        "node": { "$ref": "#/$defs/node" },
        "prev_hash": { "$ref": "#/$defs/hash" },
        "record_hash": { "$ref": "#/$defs/hash" },
        "approved": { "type": "boolean" },
        "question": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
