      "properties": {
        "ts": { "$ref": "#/$defs/timestamp" },
        "type": { "const": "checkpoint" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "round": { "$ref": "#/$defs/round" },
        "node": { "$ref": "#/$defs/node" },
        "prev_hash": { "$ref": "#/$defs/hash" },
        "record_hash": { "$ref": "#/$defs/hash" },
        "detail": { "$ref": "#/$defs/text" }
