{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent-proposal.schema.json",
  "title": "Proposed desired state; not accepted intent",
  "type": "object",
  "required": [
    "users",
    "journeys",
    "acceptance",
    "questions"
  ],
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nongoals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonfunctional_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ux_expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technical_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integration_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "security_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatibility_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "performance_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_behaviour": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "testing_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "entry",
          "steps",
          "acceptance_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "playbookStep": {
      "type": "object",
      "required": [
        "node",
        "text"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "acceptanceCriterion": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "check": {
          "$ref": "#/$defs/acceptanceCheck"
        },
        "bounds": {
          "$ref": "#/$defs/acceptanceBounds"
        }
      },
      "additionalProperties": false
    },
    "acceptanceCheck": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "file_exists",
            "file_absent",
            "grep_empty",
            "grep_matches",
            "json_path",
            "http_probe"
          ]
        },
        "cmd": {
          "type": "string",
          "minLength": 1
        },
        "path": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string" },
        "pointer": { "type": "string", "pattern": "^(|/.*)$" },
        "equals": {},
        "url": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "expect": {
          "type": "object",
          "properties": {
            "exit": {
              "type": "integer"
            },
            "stdout_includes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "acceptanceBounds": {
      "type": "object",
      "properties": {
        "write_allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write_deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
