{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "K-pi task",
  "type": "object",
  "required": [
    "job_id",
    "mode",
    "goal",
    "nongoals",
    "acceptance",
    "constraints",
    "quality_gates",
    "ac"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "mode": {
      "enum": ["gated", "autopilot"]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "nongoals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quality_gates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ac": {
      "type": "object",
      "required": ["quality"],
      "properties": {
        "quality": {
          "enum": ["executable", "partial", "narrative"]
        }
      },
      "additionalProperties": false
    },
    "playbook": {
      "type": "string",
      "minLength": 1
    },
    "runtime_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependency_baseline": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": { "$ref": "#/$defs/taskLimits" },
    "current_module_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "taskLimits": {
      "type": "object",
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxNodeRuns": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "maxRounds": { "type": "integer", "minimum": 1 },
        "maxCostUsd": { "type": "number", "minimum": 0 },
        "timeoutMs": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "acceptanceCriterion": {
      "type": "object",
      "required": ["id", "statement", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "check": { "$ref": "#/$defs/acceptanceCheck" },
        "bounds": { "$ref": "#/$defs/acceptanceBounds" }
      },
      "additionalProperties": false
    },
    "acceptanceCheck": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "file_exists",
            "file_absent",
            "grep_empty",
            "grep_matches",
            "json_path",
            "http_probe"
          ]
        },
        "cmd": { "type": "string", "minLength": 1 },
        "expect": {
          "type": "object",
          "properties": {
            "exit": { "type": "integer" },
            "stdout_includes": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "acceptanceBounds": {
      "type": "object",
      "properties": {
        "write_allow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "write_deny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
