{
	"schemaVersion": 2,
	"id": "coding-loop.auto",
	"entry": "ac-compiler",
	"nodes": [
		{
			"id": "ac-compiler",
			"type": "agent",
			"prompt": "Check the frozen task contract and acceptance quality before execution. Do not change repository files.",
			"context": {
				"mode": "isolated"
			},
			"tools": [
				"read",
				"grep",
				"find",
				"ls"
			],
			"readOnly": true
		},
		{
			"id": "specify",
			"type": "agent",
			"prompt": "Apply the spec-first skill. Research the repository and specify requirements, design, tasks, constraints, and non-goals before implementation. Do not change production files.",
			"context": {
				"mode": "isolated"
			},
			"tools": [
				"read",
				"grep",
				"find",
				"ls"
			],
			"readOnly": true
		},
		{
			"id": "plan",
			"type": "agent",
			"prompt": "Produce an implementation plan and a Dune stack.json of module boundaries from the frozen task, research, and specification. Return only JSON matching stack.schema.json (the graph engine writes stack.json). Do not change production files. If repair.json exists in the run directory, read it first: the previous plan did not deliver; it names the round, the failing acceptance criteria, the verdict or evidence and any operator guidance. Produce a materially different stack.json and plan that addresses them.",
			"context": {
				"mode": "isolated"
			},
			"tools": [
				"read",
				"grep",
				"find",
				"ls"
			],
			"readOnly": true,
			"response": {
				"path": "stack.json",
				"schema": "stack.schema.json",
				"retries": 2,
				"state": {}
			}
		},
		{
			"id": "plan-check",
			"type": "agent",
			"prompt": "Verify the frozen plan still matches the repository and has executable tasks and bounds. Do not respecify or change files.",
			"context": {
				"mode": "isolated"
			},
			"tools": [
				"read",
				"grep",
				"find",
				"ls"
			],
			"readOnly": true
		},
		{
			"id": "implement",
			"type": "agent",
			"prompt": "Apply the tdd-cycle skill. Apply the minimalist skill. Before production changes, write candidate.json.ladder, declare runtime dependencies, and capture failing test output. Implement only the current stack.json module and the smallest change satisfying the frozen acceptance criteria. Never write verdict.json or release.approved.",
			"context": {
				"mode": "thread",
				"threadKey": "coder"
			},
			"tools": [
				"read",
				"grep",
				"find",
				"ls",
				"bash",
				"edit",
				"write"
			],
			"readOnly": false
		},
		{
			"id": "test",
			"type": "agent",
			"prompt": "Apply the quality-gates skill. Run the exact task.json quality_gates and acceptance checks, then return HEAD-bound evidence. Do not claim green when any required command fails.",
			"context": {
				"mode": "isolated"
			},
			"tools": [
				"read",
				"bash"
			],
			"readOnly": false,
			"response": {
				"path": "evidence.json",
				"schema": "evidence.schema.json",
				"retries": 1,
				"state": {
					"evidence.head": "head"
				}
			}
		},
		{
			"id": "review",
			"type": "agent",
			"prompt": "Apply the isolated-review skill. Review the candidate and fresh evidence against every required acceptance criterion. Publish a schema-valid verdict.json through write_contract; do not change repository files and do not treat assistant transcript as the verdict.",
			"context": {
				"mode": "isolated"
			},
			"tools": [
				"read",
				"grep",
				"find",
				"ls"
			],
			"readOnly": true,
			"workerRole": "reviewer",
			"response": {
				"path": "verdict.json",
				"schema": "verdict.schema.json",
				"retries": 0,
				"state": {
					"review.approved": "approved",
					"review.status": "status",
					"review.output_fingerprint": "output_fingerprint"
				}
			}
		},
		{
			"id": "release.set",
			"type": "set",
			"assignments": {
				"release.approved": true,
				"status": "DONE"
			}
		},
		{
			"id": "ship",
			"type": "agent",
			"prompt": "Apply the conventional-commit skill. The control plane has put the worktree on the job branch kpi/{{job_id}}; stay on it. Stage the approved candidate with git add, then create exactly one approved commit whose subject matches ^(feat|fix|docs|refactor|test|chore)(\\(.+\\))?: and whose message ends with this exact trailer line, with no quoting or punctuation around it:\nKPI-Job: {{job_id}}\nThat trailer is how the control plane recognises this job's commit, so it must appear exactly once. If the repository has an origin remote, push exactly that branch with: git push -u origin kpi/{{job_id}}\nthen open the pull request with: gh pr create --head kpi/{{job_id}} --fill\nNever push any other branch, never force-push, never push tags, never delete a branch, and never merge: the auto-merge workflow merges after the required check passes.",
			"context": {
				"mode": "thread",
				"threadKey": "ship"
			},
			"tools": [
				"bash"
			],
			"readOnly": false
		},
		{
			"id": "unsafe",
			"type": "pause",
			"recovery": "bounds",
			"reason": "a write left the task's declared bounds",
			"resume": [
				"test"
			]
		},
		{
			"id": "needs-human",
			"type": "pause",
			"recovery": "review",
			"reason": "the review reported an untestable blocking issue, or the receipts are no longer fresh",
			"resume": [
				"implement"
			]
		},
		{
			"id": "no-progress",
			"type": "pause",
			"recovery": "no_progress",
			"reason": "the loop repeated the same evidence or review outcome after its automatic re-plans",
			"resume": [
				"plan"
			]
		}
	],
	"edges": [
		{
			"from": "ac-compiler",
			"to": "specify",
			"when": {
				"path": "plan.provided",
				"equals": false
			}
		},
		{
			"from": "ac-compiler",
			"to": "plan-check",
			"when": {
				"path": "plan.provided",
				"equals": true
			}
		},
		{
			"from": "specify",
			"to": "plan"
		},
		{
			"from": "plan",
			"to": "implement"
		},
		{
			"from": "plan-check",
			"to": "implement"
		},
		{
			"from": "implement",
			"to": "test"
		},
		{
			"from": "test",
			"to": "unsafe",
			"when": {
				"path": "bounds.held",
				"equals": false
			}
		},
		{
			"from": "test",
			"to": "implement",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": false
				},
				{
					"path": "progress.repeated",
					"equals": false
				}
			]
		},
		{
			"from": "test",
			"to": "plan",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": false
				},
				{
					"path": "progress.repeated",
					"equals": true
				},
				{
					"path": "plan.repair_tried",
					"equals": false
				},
				{
					"path": "plan.provided",
					"equals": false
				}
			]
		},
		{
			"from": "test",
			"to": "no-progress",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": false
				},
				{
					"path": "progress.repeated",
					"equals": true
				},
				{
					"path": "plan.repair_tried",
					"equals": true
				}
			]
		},
		{
			"from": "test",
			"to": "no-progress",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": false
				},
				{
					"path": "progress.repeated",
					"equals": true
				},
				{
					"path": "plan.repair_tried",
					"equals": false
				},
				{
					"path": "plan.provided",
					"equals": true
				}
			]
		},
		{
			"from": "test",
			"to": "review",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": true
				}
			]
		},
		{
			"from": "review",
			"to": "unsafe",
			"when": {
				"path": "bounds.held",
				"equals": false
			}
		},
		{
			"from": "review",
			"to": "release.set",
			"when": [
				{
					"path": "review.approved",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": true
				},
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "fingerprints.fresh",
					"equals": true
				}
			]
		},
		{
			"from": "review",
			"to": "needs-human",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": true
				},
				{
					"path": "test.passed",
					"equals": false
				}
			]
		},
		{
			"from": "review",
			"to": "needs-human",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": true
				},
				{
					"path": "fingerprints.fresh",
					"equals": false
				}
			]
		},
		{
			"from": "review",
			"to": "implement",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": false
				},
				{
					"path": "review.status",
					"equals": "REVISE"
				},
				{
					"path": "progress.repeated",
					"equals": false
				}
			]
		},
		{
			"from": "review",
			"to": "plan",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": false
				},
				{
					"path": "review.status",
					"equals": "REVISE"
				},
				{
					"path": "progress.repeated",
					"equals": true
				},
				{
					"path": "plan.repair_tried",
					"equals": false
				},
				{
					"path": "plan.provided",
					"equals": false
				}
			]
		},
		{
			"from": "review",
			"to": "no-progress",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": false
				},
				{
					"path": "review.status",
					"equals": "REVISE"
				},
				{
					"path": "progress.repeated",
					"equals": true
				},
				{
					"path": "plan.repair_tried",
					"equals": true
				}
			]
		},
		{
			"from": "review",
			"to": "no-progress",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": false
				},
				{
					"path": "review.status",
					"equals": "REVISE"
				},
				{
					"path": "progress.repeated",
					"equals": true
				},
				{
					"path": "plan.repair_tried",
					"equals": false
				},
				{
					"path": "plan.provided",
					"equals": true
				}
			]
		},
		{
			"from": "review",
			"to": "needs-human",
			"when": [
				{
					"path": "bounds.held",
					"equals": true
				},
				{
					"path": "review.approved",
					"equals": false
				},
				{
					"path": "review.status",
					"equals": "BLOCKED"
				}
			]
		},
		{
			"from": "release.set",
			"to": "ship",
			"when": {
				"path": "ship.shipped",
				"equals": false
			}
		},
		{
			"from": "release.set",
			"to": "__end__",
			"when": {
				"path": "ship.shipped",
				"equals": true
			}
		},
		{
			"from": "ship",
			"to": "__end__"
		}
	],
	"limits": {
		"maxConcurrency": 2
	},
	"policy": {
		"allowNonInteractive": true,
		"allowNonInteractiveMutations": true,
		"confirmProjectGraph": true,
		"confirmMutatingNodes": false
	}
}
